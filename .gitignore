# Allow only the public repository structure at the root.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Agents.md
!/requirements.txt
!/run.py
!/stitching.py
!/data/
!/docs/
!/third_party/

# Input photographs and data preparation metadata only.
/data/*
!/data/README.md
!/data/benchmark_sources.json
!/data/Q[123]/
/data/Q[123]/*
!/data/Q[123]/*.[jJ][pP][gG]
!/data/Q[123]/*.[jJ][pP][eE][gG]
!/data/Q[123]/*.[pP][nN][gG]
!/data/Q[123]/*.[bB][mM][pP]

# Four documents and the original assignment materials.
/docs/*
!/docs/algorithm.md
!/docs/benchmarks.md
!/docs/benchmark_results.md
!/docs/mission_results.md
!/docs/assignment/

# Local clones are never submodules or tracked vendor code.
/third_party/*
!/third_party/README.md

# Generated stitching images stay local.
/results/

# Ignore caches and generated files at any depth.
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
*.tmp
*.part
*.bak
*.log
*.zip
*.tar
*.tar.gz
.DS_Store
*~
